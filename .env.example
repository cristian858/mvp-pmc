# SafeSign AI - Configuración

# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///instance/safesign.db

# Biometría
UMBRAL_MOVIMIENTO=0.03
# Si Tesseract no esta en PATH, usa una ruta como:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# IA
USE_MOCK_AI=true
OPENAI_API_KEY=
CLAUDE_API_KEY=
