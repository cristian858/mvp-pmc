# ============================================
# SafeSign AI - Docker Configuration (.env)
# ============================================
# Copiar a .env y modificar según sea necesario

# FLASK CONFIGURATION
# -------------------------------------------
FLASK_ENV=development                    # development, production
FLASK_PORT=8080                          # Puerto donde corre la app
SECRET_KEY=super-secret-key-change-this  # Cambiar en producción
DATABASE_URL=sqlite:////app/instance/safesign.db  # SQLite en contenedor

# BIOMETRY CONFIGURATION
# -------------------------------------------
UMBRAL_MOVIMIENTO=0.03                   # Sensibilidad de detección de movimiento
TESSERACT_CMD=/usr/bin/tesseract         # Ruta a Tesseract OCR en el contenedor

# AI CONFIGURATION
# -------------------------------------------
USE_MOCK_AI=true                         # true = análisis con regex, false = API real
OPENAI_API_KEY=                          # Si usas OpenAI, agregar aquí
CLAUDE_API_KEY=                          # Si usas Claude, agregar aquí

# OPCIONAL: Para producción con PostgreSQL
# DATABASE_URL=postgresql://user:password@postgres:5432/safesign_db

# OPCIONAL: CORS para desarrollo frontend
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
